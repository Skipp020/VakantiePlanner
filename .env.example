# Supabase project URL and keys (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: server-only, NEVER expose to the browser.
# Used by Server Actions to read/write members and leave_days,
# bypassing RLS so the app can enforce "own row only" itself.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
